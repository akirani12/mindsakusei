# Required
APP_API_KEY=your-api-key-here
OPENAI_API_KEY=sk-xxx

# LLM defaults
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_DEFAULT_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
API_TIMEOUT_SECONDS=180

# Per-node overrides (optional)
# NODE_KW__MODEL=gpt-4o
# NODE_KW__TEMPERATURE=0.3
# NODE_RKW__MODEL=gpt-4o-mini
# NODE_RKW__TEMPERATURE=0.5
# NODE_SCN__TEMPERATURE=0.8
# NODE_ALT__TEMPERATURE=0.8
# NODE_MAP__TEMPERATURE=0.4

# Provider: "openai" (default) or "azure"
# LLM_PROVIDER=openai

# Azure OpenAI (only when LLM_PROVIDER=azure)
# AZURE_OPENAI_API_KEY=xxx
# AZURE_OPENAI_ENDPOINT=https://xxx.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
