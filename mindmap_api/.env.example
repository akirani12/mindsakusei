# Required
APP_API_KEY=your-api-key-here
OPENAI_API_KEY=sk-xxx

# LLM defaults
LLM_DEFAULT_MODEL=gpt-5.1
LLM_DEFAULT_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
API_TIMEOUT_SECONDS=180

# Per-node overrides (optional)
# KW uses a different model from the rest
NODE_KW__MODEL=gpt-5-chat-latest
# NODE_KW__TEMPERATURE=0.7
# NODE_RKW__MODEL=gpt-5.1
# NODE_RKW__TEMPERATURE=0.7
# NODE_SCN__MODEL=gpt-5.1
# NODE_SCN__TEMPERATURE=0.7
# NODE_ALT__MODEL=gpt-5.1
# NODE_ALT__TEMPERATURE=0.4   (DSL default)
# NODE_MAP__MODEL=gpt-5.1
# NODE_MAP__TEMPERATURE=0.3   (DSL default)

# Provider: "openai" (default) or "azure"
# LLM_PROVIDER=openai

# Azure OpenAI (only when LLM_PROVIDER=azure)
# AZURE_OPENAI_API_KEY=xxx
# AZURE_OPENAI_ENDPOINT=https://xxx.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2024-06-01
# AZURE_OPENAI_DEPLOYMENT=gpt-5.1
